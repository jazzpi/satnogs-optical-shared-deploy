# {{ ansible_managed }}
{% for server in optical_ntp_servers %}
server {{ server }} iburst
{% endfor %}

driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
leapsectz right/UTC
# The Pi has no RTC and boots on a stale clock; step it rather than slewing
# for hours. optical-acquire waits for chrony to settle either way.
makestep 1 3
rtcsync
