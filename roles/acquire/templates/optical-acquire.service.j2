# {{ ansible_managed }}
#
# No optical-gate.service: acquisition checks the clock itself on every
# cycle, so a gate would only delay start-up.
[Unit]
Description=SatNOGS Optical: acquisition (owns the camera, writes stacks to the NAS)
After=network-online.target time-sync.target chrony.service
Wants=network-online.target
RequiresMountsFor={{ optical_raw_dir }}
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User={{ optical_user }}
Group={{ optical_user }}
WorkingDirectory={{ optical_state_dir }}
ExecStart={{ optical_venv }}/bin/python -m satnogs_optical_client.acquire --config {{ optical_config_dir }}/station.toml --db {{ optical_db }} --raw-dir {{ optical_raw_dir }} --run-dir {{ optical_run_dir }}
Restart=always
RestartSec=15
WatchdogSec=300
TimeoutStopSec=90
KillMode=control-group
DeviceAllow=char-video4linux rw
DeviceAllow=char-media rw
DeviceAllow=char-dma_heap rw
DeviceAllow=char-usb_device rw
DeviceAllow=char-gpiochip rw
SupplementaryGroups=video
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ optical_state_dir }}
ReadWritePaths={{ optical_run_dir }}
ReadWritePaths={{ optical_raw_dir }}
SyslogIdentifier=optical-acquire

[Install]
WantedBy=multi-user.target
