# {{ ansible_managed }}
[Unit]
Description=SatNOGS Optical: station viewer and control surface
After=network-online.target optical-setup.service
ConditionPathExists={{ optical_config_dir }}/identity/claimed.json
StartLimitIntervalSec=600
StartLimitBurst=10

[Container]
{% include '_container.j2' %}
{% if optical_container_notify %}
Notify=true
{% endif %}
# 8080 inside: the container runs unprivileged and cannot bind 80.
PublishPort={{ optical_web_port }}:8080
Exec=python -m satnogs_optical_client.web --db {{ optical_db }} --host 0.0.0.0 --port 8080 --admin-token-file {{ optical_config_dir }}/admin-token --config {{ optical_config_dir }}/station.toml

[Service]
Restart=always
RestartSec=10
{% if optical_container_notify %}
WatchdogSec=300
{% endif %}

[Install]
WantedBy=multi-user.target
