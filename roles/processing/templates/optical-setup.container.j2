# {{ ansible_managed }}
[Unit]
Description=SatNOGS Optical: claim page (until the station is claimed)
After=network-online.target
ConditionPathExists=!{{ optical_config_dir }}/identity/claimed.json

[Container]
{% include '_container.j2' %}
{% if optical_container_notify %}
Notify=true
{% endif %}
PublishPort={{ optical_web_port }}:8080
Exec=python -m satnogs_optical_client.web.setup_app --host 0.0.0.0 --port 8080 --exit-when-claimed --db {{ optical_db }}

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
