#!/bin/sh
# The network agent's cycle: refresh elements, send telemetry, poll tasks,
# pull configuration, upload measurements, wait, repeat. Each step may fail
# without stopping the others.
#
# station.env is re-read every cycle so the token a claim writes is picked up
# without restarting the container.
set -u

: "${OPTICAL_CONFIG_DIR:=/etc/satnogs-optical}"
: "${OPTICAL_DB:=/var/lib/satnogs-optical/station.sqlite3}"
: "${OPTICAL_AGENT_INTERVAL:=60}"

agent() {
    python -m satnogs_optical_client.agent "$@" --db "$OPTICAL_DB" --url "$SATNOGS_OPTICAL_URL" \
        || echo "optical-agent-cycle: $1 failed" >&2
}

while true; do
    if [ -r "$OPTICAL_CONFIG_DIR/station.env" ]; then
        set -a
        . "$OPTICAL_CONFIG_DIR/station.env"
        set +a
    fi
    agent elements --format tle --out "$(dirname "$OPTICAL_DB")/elements"
    agent telemetry
    agent tasks
    agent config-pull
    agent upload --from-cursor
    sleep "$OPTICAL_AGENT_INTERVAL"
done
